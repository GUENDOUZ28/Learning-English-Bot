# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Database file path (default: data/vocab_bot.db)
DATABASE_PATH=data/vocab_bot.db

# Audio directory for TTS caching (default: data/audio)
AUDIO_DIR=data/audio

# Default language preference: "both" (Arabic & French), "ar" (Arabic), "fr" (French)
DEFAULT_TRANSLATION_LANG=both

# Default daily lesson delivery time (24-hour format HH:MM, e.g. 09:00)
DEFAULT_DAILY_TIME=09:00

# Daily words quota (number of words sent per day)
DAILY_WORDS_COUNT=5
